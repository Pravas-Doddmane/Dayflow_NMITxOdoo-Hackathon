# =============================================
# DayFlow — Unified Environment Variables
# =============================================
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
# NEVER commit the real .env file to version control.

# =============================================
# Database
# =============================================
POSTGRES_DB=dayflow
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_PORT=5433

# =============================================
# JWT
# =============================================
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-min-256-bits-long
# JWT expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# =============================================
# Gmail SMTP (for invitation & reset emails)
# =============================================
# Use a Gmail App Password — NOT your regular Gmail password.
# https://support.google.com/accounts/answer/185833
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# =============================================
APP_BASE_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000,http://localhost

# =============================================
# Initial Admin Account (first-run seed only)
# =============================================
ADMIN_EMAIL=admin@dayflow.local
ADMIN_PASSWORD=AdminPass@2024

# =============================================
# Service Ports (host-side)
# =============================================
# Backend REST API port (mapped from container 8080)
APP_PORT=8081
# Frontend port (mapped from container 80)
FRONTEND_PORT=3000

# =============================================
# Frontend Build-time API URL
# =============================================
# This is baked into the JS bundle at docker build time.
# Nginx inside the frontend container proxies /api/* → backend:8080,
# so for fully containerised deployments keep this as http://localhost:8081
VITE_API_BASE_URL=http://localhost:8081

# =============================================
# Token Expiry (hours) — backend application.properties defaults
# =============================================
TOKEN_SETUP_EXPIRY_HOURS=48
TOKEN_RESET_EXPIRY_HOURS=1
TOKEN_EMAIL_VERIFY_EXPIRY_HOURS=24
